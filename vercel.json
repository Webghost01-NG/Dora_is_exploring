{
  "version": 2,
  "name": "dora-the-explorer",
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/blocks",
      "dest": "api/index.js"
    },
    {
      "src": "/block/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/tx/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/address/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/verify",
      "dest": "api/index.js"
    },
    {
      "src": "/health",
      "dest": "api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "client/index.html"
    }
  ]
}
